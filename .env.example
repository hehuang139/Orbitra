# Production bind address and port used by `pnpm start`.
HOST=0.0.0.0
PORT=4173

# Configure both paths to serve the Orbitra runtime over HTTPS.
# TLS_CERT_PATH=/etc/orbitra/tls.crt
# TLS_KEY_PATH=/etc/orbitra/tls.key

# The online game library is a separate service started by `pnpm start:library`.
ADVANCE_LIBRARY_HOST=0.0.0.0
ADVANCE_LIBRARY_PORT=4174
ADVANCE_LIBRARY_DATA_DIR=.data/online-library
ADVANCE_LIBRARY_ALLOWED_ORIGINS=http://localhost:4173

# Configure both paths to serve the online library over HTTPS.
# ADVANCE_LIBRARY_TLS_CERT_PATH=/etc/orbitra-library/tls.crt
# ADVANCE_LIBRARY_TLS_KEY_PATH=/etc/orbitra-library/tls.key
