# Production bind address and port used by `pnpm start`.
HOST=0.0.0.0
PORT=4173

# Configure both paths to serve the Orbitra runtime over HTTPS.
# TLS_CERT_PATH=/etc/orbitra/tls.crt
# TLS_KEY_PATH=/etc/orbitra/tls.key

# Account data belongs to the Orbitra runtime and its same-origin /api routes.
ORBITRA_DATA_DIR=.data

# The distribution-only online game library is started separately by `pnpm start:library`.
ONLINE_LIBRARY_HOST=0.0.0.0
ONLINE_LIBRARY_PORT=4174
ONLINE_LIBRARY_ROOT=public/demo
ONLINE_LIBRARY_NAME=Orbitra Demo Library
ONLINE_LIBRARY_ALLOWED_ORIGINS=http://localhost:4173
# Required only for publishing and removing games through the management UI.
ONLINE_LIBRARY_ADMIN_TOKEN=replace-with-a-long-random-token

# Configure both paths to serve the online library over HTTPS.
# ONLINE_LIBRARY_TLS_CERT_PATH=/etc/orbitra-library/tls.crt
# ONLINE_LIBRARY_TLS_KEY_PATH=/etc/orbitra-library/tls.key

# Build-time public client ID for Orbitra Companion's Microsoft device-code login.
# Register an Entra public-client application; never reuse another launcher's client ID.
# ORBITRA_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
