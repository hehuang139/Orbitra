# Production bind address and port used by `pnpm start`.
HOST=0.0.0.0
PORT=4173

# Writable directory for the SQLite account and snapshot database.
ADVANCE_DATA_DIR=.data

# Configure both paths to serve HTTPS directly. Never commit the private key.
# TLS_CERT_PATH=/etc/advance/tls.crt
# TLS_KEY_PATH=/etc/advance/tls.key
